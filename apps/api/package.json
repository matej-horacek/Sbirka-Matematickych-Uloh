{
  "name": "@matematika/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "typecheck": "tsc --noEmit -p .",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json",
    "test": "node ../../scripts/jest-capped.mjs",
    "test:unit": "node ../../scripts/jest-capped.mjs --testPathIgnorePatterns \"\\.e2e-spec\\.ts$\"",
    "test:e2e": "node ../../scripts/jest-capped.mjs --testPathPatterns \"\\.e2e-spec\\.ts$\"",
    "test:cov": "node ../../scripts/jest-capped.mjs --coverage",
    "test:unskipped": "node ../../scripts/jest-capped.mjs --unskip --no-cache"
  },
  "dependencies": {
    "@matematika/contracts": "workspace:*",
    "@nestjs/common": "^11.2.8",
    "@nestjs/core": "^11.2.8",
    "@nestjs/platform-express": "^11.2.8",
    "@scalar/nestjs-api-reference": "^1.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "sqids": "^0.3.0",
    "yaml": "^2.8.0",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@matematika/tsconfig": "workspace:*",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.8",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-check": "^4.10.2",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "typescript": "catalog:"
  }
}
