{
  "name": "@matematika/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "typecheck": "tsc --noEmit -p .",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json",
    "test": "node ../../scripts/test-capped.mjs",
    "test:unit": "node ../../scripts/test-capped.mjs --exclude \"**/*.e2e-spec.ts\"",
    "test:e2e": "node ../../scripts/test-capped.mjs e2e-spec",
    "test:cov": "node ../../scripts/test-capped.mjs --coverage",
    "test:unskipped": "node ../../scripts/test-capped.mjs --unskip"
  },
  "dependencies": {
    "@matematika/contracts": "workspace:*",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@scalar/nestjs-api-reference": "^1.2.35",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sqids": "^0.3.0",
    "yaml": "^2.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@matematika/tsconfig": "workspace:*",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.4.0",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-check": "^4.10.2",
    "prisma": "^7.10.1",
    "prisma-dbml-generator": "^0.12.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "catalog:",
    "unplugin-swc": "^2.0.0",
    "vitest": "^4.1.12"
  }
}
