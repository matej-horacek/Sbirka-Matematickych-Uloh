{
  "name": "@matematika/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main",
    "db:generate": "prisma generate",
    "db:seed": "prisma db seed",
    "typecheck": "tsc --noEmit -p .",
    "typecheck:test": "tsc --noEmit -p test/tsconfig.json",
    "test": "node ../../scripts/jest-capped.mjs",
    "test:unit": "node ../../scripts/jest-capped.mjs --testPathIgnorePatterns \"\\.e2e-spec\\.ts$\"",
    "test:e2e": "node ../../scripts/jest-capped.mjs --testPathPatterns \"\\.e2e-spec\\.ts$\"",
    "test:cov": "node ../../scripts/jest-capped.mjs --coverage",
    "test:unskipped": "node ../../scripts/jest-capped.mjs --unskip --no-cache"
  },
  "dependencies": {
    "@matematika/contracts": "workspace:*",
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
    "@nestjs/platform-express": "^12.4.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "^7.10.1",
    "@scalar/nestjs-api-reference": "^1.2.35",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sqids": "^0.3.0",
    "yaml": "^2.9.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@matematika/tsconfig": "workspace:*",
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.4.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "fast-check": "^4.10.2",
    "jest": "^30.5.2",
    "prisma": "^7.10.1",
    "prisma-dbml-generator": "^0.12.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "catalog:"
  }
}
