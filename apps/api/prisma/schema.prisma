  chapter      chapter   @relation(fields: [chapter_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  worksheet    worksheet @relation(fields: [worksheet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([worksheet_id, chapter_id])
  @@index([chapter_id])
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model worksheet_problem {
  worksheet_id Int
  problem_id   Int
  position     String    @db.VarChar(64)
  problem      problem   @relation(fields: [problem_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  worksheet    worksheet @relation(fields: [worksheet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([worksheet_id, problem_id])
  @@unique([worksheet_id, position], map: "worksheet_problem_worksheet_id_position_idx")
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model worksheet_share {
  worksheet_id Int
  recipient_id Int
  created_at   DateTime  @default(now()) @db.Timestamptz(6)
  user         user      @relation(fields: [recipient_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  worksheet    worksheet @relation(fields: [worksheet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([worksheet_id, recipient_id])
  @@index([recipient_id])
}

/// This model has constraints using non-default deferring rules and requires additional setup for migrations. Visit https://pris.ly/d/constraint-deferring for more info.
model worksheet_tag {
  worksheet_id Int
  tag_id       Int
  tag          tag       @relation(fields: [tag_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  worksheet    worksheet @relation(fields: [worksheet_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([worksheet_id, tag_id])
  @@index([tag_id])
}

enum asset_status {
  PENDING
  READY
}

enum asset_type {
  IMAGE
}

enum attachment_placement {
  BELOW
  RIGHT
}

enum attachment_size {
  S
  M
  L
}

enum audit_target_type {
  PROBLEM
  WORKSHEET
  USER
  CHAPTER
  TAG
  REPORT
  LICENSE
  LANGUAGE
}

enum citation_audience {
  PUBLIC
  TEACHER_ONLY
}

enum content_origin {
  OWN
  LICENSED_USE
  FREE_USE
}

enum moderation_action {
  APPROVED
  REJECTED
  WITHDRAWN
  BLOCKED
  UNBLOCKED
  TEACHER_VERIFIED
  TRUST_GRANTED
  TRUST_REVOKED
  ROLE_CHANGED
  ACCOUNT_BLOCKED
  ACCOUNT_UNBLOCKED
  ACCOUNT_DELETED
  REPORT_DISMISSED
  CHAPTER_EDITED
  TAG_MERGED
  TAG_RENAMED
  CODELIST_EDITED
}

enum notification_type {
  CONTENT_APPROVED
  CONTENT_REJECTED
  CONTENT_WITHDRAWN
  CONTENT_BLOCKED
  CONTENT_UNBLOCKED
  SET_CHILD_REMOVED
  WORKSHEET_ITEM_REMOVED
  ACCOUNT_VERIFIED
