}

enum publish_status {
  PRIVATE
  REVIEWING
  PUBLISHED
  WITHDRAWN
  BLOCKED
}

enum report_category {
  COPYRIGHT
  INAPPROPRIATE
  ILLEGAL
  OTHER
}

enum report_status {
  OPEN
  DISMISSED
  RESOLVED
}

enum report_target_type {
  PROBLEM
  WORKSHEET
  USER
}

enum request_status {
  PENDING
  APPROVED
  REJECTED
}

enum revision_status {
  REVIEWING
  APPROVED
  REJECTED
}

enum user_role {
  SUPERADMIN
  ADMIN
