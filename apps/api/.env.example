# API settings (copy to apps/api/.env). Mock mode needs none of these.
PORT=3000
# Comma-separated origins allowed by CORS (default: the Vite dev server)
CORS_ORIGIN=http://localhost:5173
# mock (default) | prisma
DATA_SOURCE=prisma
DATABASE_URL=postgresql://app:app@localhost:5434/sbirka

# Auth (src/config/auth-config.ts). Commented out = the default in brackets is used.
# Do not leave a key empty: an empty JWT_SECRET is treated as missing and the API fails to start.
# Signing key of the access token [built-in dev secret]; REQUIRED when NODE_ENV=production
# JWT_SECRET=change-me-to-a-long-random-string
# Access token lifetime in seconds [900 = 15 min]
# ACCESS_TOKEN_TTL_SECONDS=900
# Refresh token lifetime in days [7]
# REFRESH_TOKEN_TTL_DAYS=7
# Secure cookies (need https) [true only when NODE_ENV=production]
# COOKIE_SECURE=false

# Shuffled alphabet for public ids [Sqids default]. Set in production;
# changing it changes every id (the seeded ids in the README stop matching).
# SQIDS_ALPHABET=
