{
  "name": "matematika-api",
  "version": "0.1.0",
  "private": true,
  "description": "Mock backend (NestJS, in-memory data) for the community collection of math problems.",
  "scripts": {
    "generate": "openapi-ts",
    "postinstall": "npm run generate",
    "prebuild": "npm run generate",
    "build": "nest build",
    "predev": "npm run generate",
    "dev": "nest start --watch",
    "start": "node dist/main",
